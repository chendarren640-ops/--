; CIMC 2026 Bootloader Scatter File
; Flash 地址: 0x08000000, 大小 64K (0x10000)
; 赛题 2.5 节规定: Bootloader 区 0x08000000 ~ 0x0800FFFF

LR_IROM1 0x08000000 0x10000  {

  ER_IROM1 0x08000000 0x10000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }

  RW_IRAM1 0x20000000 0x30000  {
   .ANY (+RW +ZI)
  }
}
